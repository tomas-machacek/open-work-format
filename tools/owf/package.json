{
  "name": "@owf/tool",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "owf": "dist/bootstrap/cli.js"
  },
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "dev": "tsx src/bootstrap/cli.ts",
    "typecheck": "tsc --noEmit && tsc -p src/web/tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "architecture:check": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run src",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e && playwright test",
    "test:acceptance": "node --import tsx node_modules/@cucumber/cucumber/bin/cucumber.js",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run architecture:check && npm run build && npm test && npm run test:integration && npm run test:acceptance && npm run test:e2e",
    "release": "release-it",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fastify/static": "10.1.4",
    "commander": "15.0.0",
    "fastify": "5.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.3.1",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.1",
    "prettier": "3.9.7",
    "release-it": "21.0.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
